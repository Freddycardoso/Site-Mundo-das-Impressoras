---
import { MessageCircle, Zap } from 'lucide-react';
import { getWhatsAppLink, getOutsourcingWhatsAppLink } from '../utils/whatsapp';

const directWhatsApp = getWhatsAppLink('Olá! Vim pelo site da Mundo das Impressoras e gostaria de atendimento.');
const mobileWhatsApp = getWhatsAppLink('Olá! Vim pelo site da Mundo das Impressoras e gostaria de cotação.');
const outsourcingWhatsApp = getOutsourcingWhatsAppLink();
---

{/* Desktop Floating Action Widget (Bottom Right) with Double-Bezel Hardware Enclosure */}
<div class="hidden sm:block fixed bottom-6 right-6 z-40">
  <div class="p-1 rounded-full bg-slate-900/10 border border-slate-300/50 shadow-2xl backdrop-blur-md">
    <a
      href={directWhatsApp}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center gap-3.5 pl-2.5 pr-4 py-2 bg-white rounded-full transition-all duration-200 hover:shadow-lg active:scale-[0.97]"
      aria-label="Abrir WhatsApp da Mundo das Impressoras"
    >
      <div class="relative">
        <div class="w-10 h-10 rounded-full bg-emerald-500 flex items-center justify-center text-slate-950 transition-colors shadow-md">
          <MessageCircle class="w-5 h-5" />
        </div>
        <span class="absolute -top-0.5 -right-0.5 w-3 h-3 bg-emerald-400 border-2 border-white rounded-full animate-pulse"></span>
      </div>

      <div class="text-left pr-1">
        <div class="text-xs font-bold text-slate-900 font-display group-hover:text-blue-600 transition-colors">
          WhatsApp Direto
        </div>
        <div class="text-[11px] text-slate-400 font-mono">
          Passos-MG · Online
        </div>
      </div>
    </a>
  </div>
</div>

{/* Mobile Sticky Bottom Conversion Bar */}
<div class="sm:hidden fixed bottom-0 inset-x-0 z-40 bg-white/90 backdrop-blur-xl border-t border-slate-200/80 px-4 pt-2.5 pb-[calc(0.6rem+env(safe-area-inset-bottom))] shadow-[0_-8px_30px_rgba(0,0,0,0.08)]">
  <div class="flex items-center gap-2.5">
    <a
      href={mobileWhatsApp}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 py-2.5 px-4 bg-emerald-500 active:bg-emerald-600 text-slate-950 font-bold text-xs rounded-full flex items-center justify-center gap-2 shadow-sm whitespace-nowrap active:scale-[0.97] transition-all"
    >
      <MessageCircle class="w-4 h-4" />
      <span>WhatsApp (35) 99953-6494</span>
    </a>

    <a
      href={outsourcingWhatsApp}
      target="_blank"
      rel="noopener noreferrer"
      class="py-2.5 px-4 bg-blue-50 active:bg-blue-100 text-blue-700 border border-blue-200 font-bold text-xs rounded-full flex items-center justify-center gap-1.5 whitespace-nowrap active:scale-[0.97] transition-all"
    >
      <Zap class="w-3.5 h-3.5 text-blue-600" />
      <span>Estudo B2B</span>
    </a>
  </div>
</div>
