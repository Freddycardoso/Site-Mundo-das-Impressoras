---
import { Wrench, Truck, Clock, ShieldAlert, MessageCircle } from 'lucide-react';
import { SUPPORTED_BRANDS } from '../data/categories';

const servicesList = [
  {
    title: 'Desentupimento de Cabeça de Impressão',
    desc: 'Processo técnico por ultrassom e solventes específicos para recuperar bicos obstruídos em impressoras Epson EcoTank, Canon MegaTank e Brother.',
    badge: 'Recuperação 95%',
  },
  {
    title: 'Troca de Almofadas & Reset de Contador',
    desc: 'Substituição das esponjas coletoras saturadas de tinta e reset de software das impressoras que travam com mensagem de fim da vida útil.',
    badge: 'Solução Imediata',
  },
  {
    title: 'Reparo de Fusor & Película Térmica',
    desc: 'Solução para impressoras laser que amassam papel, mancham o verso da folha ou apresentam erro de aquecimento do fusor.',
    badge: 'Laser Mono e Cor',
  },
  {
    title: 'Troca de Roletes Tracionadores (Pick-up Rollers)',
    desc: 'Troca da borracha de tração que patina e não puxa o papel da gaveta, eliminando o clássico atolamento contínuo.',
    badge: 'Todas as Marcas',
  },
  {
    title: 'Manutenção Preventiva & Higienização Completa',
    desc: 'Desmontagem, aspiração de pó de toner ou poeira de papel, lubrificação técnica dos trilhos e calibração de sensores ópticos.',
    badge: 'Vida Útil Longa',
  },
  {
    title: 'Conserto de Placa Lógica e Fonte de Alimentação',
    desc: 'Reparo em nível de componente eletrônico para impressoras que não ligam ou não comunicam via USB/Rede após oscilação elétrica.',
    badge: 'Laboratório Próprio',
  },
];
---

<section id="servicos" class="relative py-28 lg:py-36 bg-[#f8fafc] border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto space-y-3.5">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-50 px-3.5 py-1 text-[11px] font-semibold tracking-[0.2em] uppercase text-blue-600">
        Assistência Técnica Especializada · Passos - MG
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-[-0.035em] text-slate-900 font-display text-balance">
        Conserto rápido com peças de qualidade e laboratório local.
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
        Sua impressora parou? Nossa equipe técnica realiza diagnóstico transparente,
        com opção de coleta no seu endereço comercial em Passos e região.
      </p>
    </div>

    {/* Brands Ticker / Logo Grid */}
    <div class="mt-12 py-8">
      <div class="text-center text-xs font-semibold uppercase tracking-wider text-slate-400 mb-6">
        Marcas atendidas com peças de reposição em estoque:
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10">
        {SUPPORTED_BRANDS.map((brand) => (
          <div
            key={brand.name}
            class="flex flex-col items-center justify-center grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300 ease-in-out cursor-default"
          >
            <div class="text-xl sm:text-2xl font-black text-slate-800 font-display tracking-tight">
              {brand.name}
            </div>
            <div class="text-[10px] text-slate-500 font-medium tracking-wide">
              {brand.category}
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* 2-Column: Services Grid + Fast Collection Request Form */}
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      {/* Left Column: Services list with Double-Bezel */}
      <div class="lg:col-span-7 space-y-5">
        <h3 class="text-xl font-bold text-slate-900 font-display flex items-center gap-2.5">
          <Wrench class="w-5 h-5 text-blue-600" />
          <span>Principais Reparos Realizados em Nossa Bancada</span>
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          {servicesList.map((srv) => (
            <div
              key={srv.title}
              class="double-bezel-outer group transition-all duration-300 hover:-translate-y-1 flex flex-col"
            >
              <div class="double-bezel-inner p-5 space-y-2 flex flex-col justify-between">
                <div class="space-y-1">
                  <div class="font-bold text-sm text-slate-900 font-display">{srv.title}</div>
                  <p class="text-xs text-slate-600 leading-relaxed font-normal">
                    {srv.desc}
                  </p>
                </div>
                <div class="text-[11px] font-mono font-semibold text-blue-600 pt-2 border-t border-slate-100">
                  {srv.badge}
                </div>
              </div>
            </div>
          ))}
        </div>

        {/* Quick trust metrics */}
        <div class="p-4 rounded-2xl bg-blue-50/80 border border-blue-100 flex flex-wrap items-center justify-between gap-4 text-xs font-semibold text-blue-900">
          <span class="flex items-center gap-2">
            <Truck class="w-4 h-4 text-blue-600" />
            <span>Serviço de Coleta e Entrega em Passos</span>
          </span>
          <span class="flex items-center gap-2">
            <ShieldAlert class="w-4 h-4 text-blue-600" />
            <span>Garantia de 90 dias nos reparos</span>
          </span>
          <span class="flex items-center gap-2">
            <Clock class="w-4 h-4 text-blue-600" />
            <span>Orçamento sem surpresas</span>
          </span>
        </div>
      </div>

      {/* Right Column: Direct Maintenance / Collection Request Box (Double-Bezel Hardware Console) */}
      <div class="lg:col-span-5 rounded-[2rem] p-1.5 bg-slate-900 border border-white/10 shadow-2xl my-4 lg:my-0">
        <div class="rounded-[calc(2rem-0.375rem)] bg-slate-950 p-6 sm:p-8 space-y-5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]">
          <div class="space-y-1.5">
            <div class="text-[11px] font-mono text-blue-400 font-semibold uppercase tracking-wider">
              Passo 1 de 1 · Atendimento Ágil
            </div>
            <h3 class="text-2xl font-bold font-display text-white">
              Agendar Manutenção ou Coleta
            </h3>
            <p class="text-xs text-slate-300">
              Preencha os dados abaixo para adiantar seu atendimento direto no WhatsApp técnico.
            </p>
          </div>

          <form id="tech-service-form" class="space-y-4">
            <div class="space-y-1.5">
              <label for="service-select" class="text-xs font-semibold text-slate-200 block">
                Qual serviço você precisa?
              </label>
              <select
                id="service-select"
                class="w-full px-4 py-3 text-xs sm:text-sm bg-white/10 border border-white/15 rounded-xl text-white focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 [&>option]:bg-slate-900 [&>option]:text-white transition-all"
              >
                <option value="Manutenção Corretiva Geral">Manutenção Corretiva Geral</option>
                <option value="Desentupimento de Cabeça">Desentupimento de Cabeça</option>
                <option value="Troca de Almofadas / Reset">Troca de Almofadas / Reset de Contador</option>
                <option value="Atolamento de Papel (Roletes)">Atolamento de Papel (Roletes)</option>
                <option value="Problema no Fusor / Barulho">Problema no Fusor / Barulho</option>
                <option value="Solicitar Coleta de Equipamento">Solicitar Coleta em Passos</option>
              </select>
            </div>

            <div class="space-y-1.5">
              <label for="equipment-model-input" class="text-xs font-semibold text-slate-200 block">
                Marca e Modelo da Impressora
              </label>
              <input
                id="equipment-model-input"
                type="text"
                placeholder="Ex: Epson L3150, HP 107w, Brother L5652..."
                class="w-full px-4 py-3 text-xs sm:text-sm bg-white/10 border border-white/15 rounded-xl text-white placeholder:text-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
              />
            </div>

            <div class="space-y-1.5">
              <label for="problem-desc-input" class="text-xs font-semibold text-slate-200 block">
                O que está acontecendo com ela? (Opcional)
              </label>
              <textarea
                id="problem-desc-input"
                rows="3"
                placeholder="Ex: Não puxa o papel, luz vermelha piscando, mancha preta no meio da folha..."
                class="w-full px-4 py-3 text-xs sm:text-sm bg-white/10 border border-white/15 rounded-xl text-white placeholder:text-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 resize-none transition-all"
              ></textarea>
            </div>

            {/* Nested Island CTA button */}
            <button
              type="submit"
              class="group w-full py-2.5 pl-6 pr-2 text-xs sm:text-sm font-bold text-white bg-blue-600 hover:bg-blue-500 active:scale-[0.97] rounded-full shadow-lg shadow-blue-600/30 flex items-center justify-between transition-all duration-200 cursor-pointer"
            >
              <span>Solicitar Coleta / Agendamento</span>
              <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center transition-transform duration-200 group-hover:translate-x-0.5">
                <MessageCircle class="w-4 h-4" />
              </div>
            </button>

            <div class="text-[11px] text-center text-slate-400">
              Atendimento presencial em Passos - MG · Resposta rápida
            </div>
          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('tech-service-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const service = (document.getElementById('service-select') as HTMLSelectElement)?.value || 'Manutenção Corretiva Geral';
    const model = (document.getElementById('equipment-model-input') as HTMLInputElement)?.value?.trim() || '';
    const desc = (document.getElementById('problem-desc-input') as HTMLTextAreaElement)?.value?.trim() || '';

    const parts = [
      'Olá, gostaria de agendar uma manutenção / solicitar coleta com a assistência técnica da Mundo das Impressoras.',
    ];
    if (service) parts.push(`Tipo de serviço: ${service}`);
    if (model) parts.push(`Modelo da impressora: ${model}`);
    if (desc) parts.push(`Sintoma/Problema: ${desc}`);
    parts.push('Estou localizado em Passos/região.');

    const url = `https://wa.me/5535999536494?text=${encodeURIComponent(parts.join('\n'))}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>
