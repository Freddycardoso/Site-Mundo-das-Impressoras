---
import { MessageCircle, Check, ArrowUpRight, X, Printer } from 'lucide-react';
import { CATEGORIES } from '../data/categories';
import CategoryVisual3D from './CategoryVisual3D.astro';
import { getCategoryWhatsAppLink } from '../utils/whatsapp';

const customQuoteUrl = getCategoryWhatsAppLink('Cotação Personalizada de Suprimentos');
---

<section id="vitrine" class="relative py-24 bg-slate-100 border-b border-blue-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-10 border-b border-blue-100">
      <div class="space-y-3 max-w-2xl">
        <div class="text-xs font-mono text-blue-600 font-semibold tracking-wider uppercase">
          Vitrine de Categorias · Cotação Sem Burocracia
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 font-display text-balance">
          Suprimentos certificados e equipamentos para cada demanda.
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Sem carrinhos complexos ou estoques desatualizados. Escolha a categoria e fale
          direto com nossa equipe técnica de Passos para receber disponibilidade e preço imediato.
        </p>
      </div>

      {/* Interactive filter segmented control */}
      <div class="flex items-center gap-1.5 p-1 bg-white border border-blue-100 rounded-xl shrink-0 self-start md:self-end shadow-md shadow-slate-200/50" id="category-filter-buttons">
        <button
          type="button"
          data-filter="all"
          class="filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all bg-blue-600 text-white shadow-sm cursor-pointer"
        >
          Todas (6)
        </button>
        <button
          type="button"
          data-filter="suprimentos"
          class="filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all text-slate-500 hover:text-blue-600 cursor-pointer"
        >
          Suprimentos
        </button>
        <button
          type="button"
          data-filter="equipamentos"
          class="filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all text-slate-500 hover:text-blue-600 cursor-pointer"
        >
          Equipamentos
        </button>
      </div>
    </div>

    {/* Categories Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 pt-10" id="categories-grid">
      {CATEGORIES.map((category) => {
        const directWhatsAppUrl = getCategoryWhatsAppLink(category.title);
        
        let filterType = 'suprimentos';
        if (category.id.includes('termica') || category.id.includes('corporativa')) {
          filterType = 'equipamentos';
        }

        return (
          <div
            key={category.id}
            data-category-id={category.id}
            data-category-type={filterType}
            data-category-title={category.title}
            data-popular-models={JSON.stringify(category.popularModels || [])}
            class="category-card group relative rounded-2xl bg-white border border-blue-100/60 p-5 sm:p-6 transition-all duration-300 hover:-translate-y-1 shadow-md shadow-slate-200/40 hover:shadow-xl hover:shadow-blue-900/10 hover:border-blue-200 flex flex-col justify-between"
          >
            {/* 3D Visual Artwork Component */}
            <div class="mb-5">
              <CategoryVisual3D type={category.iconType} accent={category.accentColor} />
            </div>

            {/* Category Details */}
            <div class="space-y-3 flex-1 flex flex-col justify-between">
              <div class="space-y-2">
                {/* Category badge */}
                <div class="flex items-center justify-between text-xs text-slate-400 font-mono">
                  <span class="text-blue-600 font-semibold">{category.badge}</span>
                  <span>Passos & Região</span>
                </div>

                <h3 class="text-lg sm:text-xl font-bold text-slate-900 font-display group-hover:text-blue-600 transition-colors">
                  {category.title}
                </h3>

                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {category.shortDesc}
                </p>
              </div>

              {/* Feature Highlights */}
              <div class="py-3 border-y border-blue-50 space-y-1.5">
                {category.highlights.slice(0, 3).map((hl) => (
                  <div class="flex items-center gap-2 text-xs text-slate-600">
                    <Check class="w-3.5 h-3.5 text-blue-600 shrink-0" />
                    <span class="truncate">{hl}</span>
                  </div>
                ))}
              </div>

              {/* Actions Bar */}
              <div class="pt-2 space-y-2">
                <a
                  href={directWhatsAppUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full min-h-[44px] py-2.5 px-4 text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 active:scale-[0.98] rounded-xl flex items-center justify-center gap-2 transition-all shadow-md shadow-blue-600/15"
                >
                  <MessageCircle class="w-4 h-4" />
                  <span>Cotar no WhatsApp</span>
                </a>

                <button
                  type="button"
                  data-open-modal={category.id}
                  class="open-modal-trigger w-full min-h-[44px] py-2 px-3 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
                >
                  <span>Tenho um modelo específico</span>
                  <ArrowUpRight class="w-3.5 h-3.5" />
                </button>
              </div>

            </div>
          </div>
        );
      })}
    </div>

    {/* Bottom Banner for custom quotes */}
    <div class="mt-14 p-6 rounded-2xl bg-blue-600 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left space-y-1">
        <h4 class="text-base font-bold text-white font-display">
          Não encontrou o que procura ou precisa de cotação em grande lote?
        </h4>
        <p class="text-xs sm:text-sm text-blue-100/70">
          Trabalhamos sob encomenda rápida para marcas específicas com faturamento direto para empresas.
        </p>
      </div>

      <a
        href={customQuoteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-2.5 min-h-[44px] text-xs font-semibold text-blue-600 bg-white hover:bg-blue-50 rounded-xl flex items-center justify-center whitespace-nowrap active:scale-95 transition-all shrink-0"
      >
        Falar com Consultor
      </a>
    </div>

  </div>

  {/* Native HTML5 Dialog for Specific Model Inquiry */}
  <dialog id="model-modal" class="fixed inset-0 m-auto p-0 bg-transparent backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm max-w-lg w-[calc(100%-2rem)] rounded-2xl shadow-2xl border-0">
    <div class="relative w-full rounded-2xl bg-white border border-blue-100 p-6 sm:p-7 shadow-2xl space-y-5">
      {/* Close Button */}
      <button
        id="close-modal-btn"
        type="button"
        class="absolute top-4 right-4 p-2 rounded-lg text-blue-900/40 hover:text-blue-800 hover:bg-blue-50 transition-colors cursor-pointer"
        aria-label="Fechar"
      >
        <X class="w-5 h-5" />
      </button>

      {/* Modal Header */}
      <div class="space-y-1.5 pr-8">
        <div class="text-xs font-mono text-blue-600 font-semibold tracking-wider uppercase">
          Cotação Direta WhatsApp
        </div>
        <h3 id="modal-category-title" class="text-xl font-bold font-display text-blue-950">
          Categoria
        </h3>
        <p class="text-xs sm:text-sm text-blue-950/60">
          Informe o modelo da sua impressora para conferirmos a compatibilidade exata em nosso estoque de Passos-MG.
        </p>
      </div>

      {/* Form */}
      <form id="modal-quote-form" class="space-y-4">
        <div class="space-y-1.5">
          <label for="printer-model-input" class="block text-xs font-medium text-slate-600">
            Modelo da sua impressora ou código do suprimento
          </label>
          <div class="relative">
            <Printer class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
            <input
              id="printer-model-input"
              type="text"
              placeholder="Ex: HP LaserJet 107w, Epson L3250, Brother TN-1060..."
              class="w-full pl-10 pr-4 py-2.5 text-sm bg-slate-50 border border-blue-100 rounded-xl text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all"
            />
          </div>
        </div>

        {/* Quick select chips for popular models */}
        <div id="modal-chips-container" class="space-y-2">
          <span class="text-[11px] text-slate-400 font-medium">Modelos frequentes na região:</span>
          <div id="modal-chips-list" class="flex flex-wrap gap-1.5">
            {/* Injected dynamically by lightweight vanilla JS */}
          </div>
        </div>

        {/* Action Buttons */}
        <div class="pt-2 flex flex-col sm:flex-row items-center gap-2.5">
          <button
            type="submit"
            class="w-full sm:flex-1 min-h-[44px] py-3 px-4 text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 active:scale-[0.98] rounded-xl flex items-center justify-center gap-2 shadow-lg shadow-blue-600/20 transition-all cursor-pointer"
          >
            <MessageCircle class="w-4 h-4" />
            <span>Verificar Disponibilidade no WhatsApp</span>
          </button>
          <button
            id="cancel-modal-btn"
            type="button"
            class="w-full sm:w-auto min-h-[44px] py-3 px-4 text-xs font-medium text-slate-500 hover:text-slate-700 bg-slate-50 hover:bg-slate-100 rounded-xl transition-colors cursor-pointer"
          >
            Cancelar
          </button>
        </div>
      </form>

      <div class="text-[11px] text-center text-slate-400">
        Você será direcionado diretamente ao WhatsApp com a mensagem pronta.
      </div>
    </div>
  </dialog>
</section>

<script>
  // Filter functionality
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.category-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      
      // Update button styles
      filterBtns.forEach((b) => {
        b.className = 'filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all text-slate-500 hover:text-blue-600 cursor-pointer';
      });
      btn.className = 'filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all bg-blue-600 text-white shadow-sm cursor-pointer';

      // Show/Hide cards
      cards.forEach((card) => {
        const type = card.dataset.categoryType;
        if (filter === 'all' || type === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Modal dialog functionality
  const dialog = document.getElementById('model-modal') as HTMLDialogElement | null;
  const modalTitle = document.getElementById('modal-category-title');
  const modalInput = document.getElementById('printer-model-input') as HTMLInputElement | null;
  const chipsList = document.getElementById('modal-chips-list');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-modal-btn');
  const quoteForm = document.getElementById('modal-quote-form');

  let activeCategoryTitle = '';

  document.querySelectorAll<HTMLButtonElement>('.open-modal-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.category-card') as HTMLElement | null;
      if (!card || !dialog) return;

      activeCategoryTitle = card.dataset.categoryTitle || 'Suprimentos';
      if (modalTitle) modalTitle.textContent = activeCategoryTitle;
      if (modalInput) modalInput.value = '';

      // Populate chips
      if (chipsList) {
        chipsList.innerHTML = '';
        try {
          const models: string[] = JSON.parse(card.dataset.popularModels || '[]');
          models.forEach((m) => {
            const chip = document.createElement('button');
            chip.type = 'button';
            chip.className = 'text-xs px-2.5 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 hover:text-blue-700 border border-blue-100 hover:border-blue-300 text-blue-700 transition-all cursor-pointer text-left';
            chip.textContent = '+ ' + m;
            chip.addEventListener('click', () => {
              if (modalInput) modalInput.value = m;
            });
            chipsList.appendChild(chip);
          });
        } catch (e) {
          // ignore
        }
      }

      dialog.showModal();
    });
  });

  closeModalBtn?.addEventListener('click', () => dialog?.close());
  cancelModalBtn?.addEventListener('click', () => dialog?.close());

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  quoteForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const model = modalInput?.value?.trim() || '';
    let msg = `Olá, vi o site e tenho interesse na categoria ${activeCategoryTitle}.`;
    if (model) {
      msg = `Olá, vi o site da Mundo das Impressoras e tenho interesse na categoria "${activeCategoryTitle}" para o equipamento/modelo: ${model}. Gostaria de verificar disponibilidade e cotação.`;
    }
    const url = `https://wa.me/5535999536494?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
    dialog?.close();
  });
</script>
