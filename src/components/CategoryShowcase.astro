---
import { MessageCircle, Check, ArrowUpRight, X, Printer, ShieldCheck } from 'lucide-react';
import { CATEGORIES } from '../data/categories';
import { getCategoryWhatsAppLink } from '../utils/whatsapp';

const customQuoteUrl = getCategoryWhatsAppLink('Cotação Personalizada de Suprimentos Corporativos');

const categoryHardwareImageMap: Record<string, { image: string; spec: string }> = {
  'toners-compativeis': {
    image: '/images/toners.jpg',
    spec: 'ISO/IEC 19752 · Alto Rendimento',
  },
  'cartuchos-tintas': {
    image: '/images/tintas.png',
    spec: 'Refil Anti-entupimento MicroPiezo',
  },
  'impressoras-termicas': {
    image: '/images/termicas.jpg',
    spec: '260 mm/s · Automação PDV & Cupom',
  },
  'multifuncionais-corporativas': {
    image: '/images/multifuncionais.png',
    spec: 'Laser Corporativa · 42-52 PPM Duplex',
  },
  'pecas-assistencia': {
    image: '/images/pecas.jpg',
    spec: 'Componentes Originais · Bancada Local',
  },
  'bobinas-papeis': {
    image: '/images/bobinas.jpg',
    spec: 'Térmica 80mm · Sem Desgaste Térmico',
  },
};
---

<section id="vitrine" class="relative py-28 lg:py-36 bg-[#fbfbfa] border-b border-[#0a2540]/[0.06]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-12 border-b border-[#0a2540]/[0.06]">
      <div class="space-y-3.5 max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#0a2540]/[0.08] bg-white px-3.5 py-1 text-[11px] font-semibold tracking-[0.18em] uppercase text-[#0a2540] shadow-sm">
          Vitrine de Equipamentos & Suprimentos Homologados
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-[-0.035em] text-[#0a2540] font-display text-balance">
          Maquinário corporativo e suprimentos para cada demanda.
        </h2>
        <p class="text-sm sm:text-base text-[#425466] leading-relaxed font-normal">
          Sem catálogos desatualizados ou esperas burocráticas. Escolha a categoria e consulte
          nossa equipe técnica de Passos para pronta-entrega ou contrato de locação corporativa.
        </p>
      </div>

      {/* Interactive filter segmented pill control */}
      <div class="flex items-center gap-1 p-1 bg-[#0a2540]/[0.04] border border-[#0a2540]/[0.06] rounded-full shrink-0 self-start md:self-end shadow-inner" id="category-filter-buttons">
        <button
          type="button"
          data-filter="all"
          class="filter-btn px-4 py-1.5 text-xs font-bold rounded-full transition-all duration-200 bg-[#0a2540] text-white shadow-sm cursor-pointer active:scale-[0.97]"
        >
          Todas (6)
        </button>
        <button
          type="button"
          data-filter="suprimentos"
          class="filter-btn px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 text-[#425466] hover:text-[#0a2540] cursor-pointer active:scale-[0.97]"
        >
          Suprimentos
        </button>
        <button
          type="button"
          data-filter="equipamentos"
          class="filter-btn px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 text-[#425466] hover:text-[#0a2540] cursor-pointer active:scale-[0.97]"
        >
          Equipamentos
        </button>
      </div>
    </div>

    {/* Categories Grid with Real Volumetric Hardware Photography */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 pt-12" id="categories-grid">
      {CATEGORIES.map((category) => {
        const directWhatsAppUrl = getCategoryWhatsAppLink(category.title);
        const hardwareInfo = categoryHardwareImageMap[category.id] || {
          image: '/printer-hero.png',
          spec: 'Equipamento Certificado',
        };
        
        let filterType = 'suprimentos';
        if (category.id.includes('termica') || category.id.includes('corporativa')) {
          filterType = 'equipamentos';
        }

        return (
          <div
            key={category.id}
            data-category-id={category.id}
            data-category-type={filterType}
            data-category-title={category.title}
            data-popular-models={JSON.stringify(category.popularModels || [])}
            class="category-card group double-bezel-outer transition-all duration-300 hover:-translate-y-1.5 flex flex-col"
          >
            <div class="double-bezel-inner p-6 sm:p-7 flex flex-col justify-between">
              
              {/* Real Volumetric Hardware Photography Window */}
              <div class="relative w-full h-44 rounded-xl overflow-hidden bg-slate-50/80 border border-[#0a2540]/[0.06] mb-5 group-hover:border-[#0052cc]/25 transition-all duration-300">
                <img 
                  src={hardwareInfo.image} 
                  alt={category.title} 
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                  width="400"
                  height="220"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0a2540]/40 via-transparent to-transparent pointer-events-none opacity-60"></div>
                <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between pointer-events-none">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-white/95 backdrop-blur-md text-[10px] font-mono font-bold text-[#0a2540] shadow-sm border border-[#0a2540]/[0.08]">
                    {hardwareInfo.spec}
                  </span>
                </div>
              </div>

              {/* Category Details */}
              <div class="space-y-4 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  {/* Category badge */}
                  <div class="flex items-center justify-between text-xs text-[#425466] font-mono">
                    <span class="text-[#0052cc] font-semibold">{category.badge}</span>
                    <span class="text-[11px] text-[#425466]">Passos & Região</span>
                  </div>

                  <h3 class="text-xl font-bold text-[#0a2540] font-display group-hover:text-[#0052cc] transition-colors">
                    {category.title}
                  </h3>

                  <p class="text-xs sm:text-sm text-[#425466] leading-relaxed font-normal">
                    {category.shortDesc}
                  </p>
                </div>

                {/* Feature Highlights */}
                <div class="py-3 border-y border-[#0a2540]/[0.06] space-y-1.5">
                  {category.highlights.slice(0, 3).map((hl) => (
                    <div class="flex items-center gap-2 text-xs text-[#425466]">
                      <Check class="w-3.5 h-3.5 text-[#0052cc] shrink-0" />
                      <span class="truncate">{hl}</span>
                    </div>
                  ))}
                </div>

                {/* Actions Bar with Nested Island CTA Button */}
                <div class="pt-3 space-y-2">
                  <a
                    href={directWhatsAppUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/btn w-full min-h-[46px] py-2 pl-5 pr-2 text-xs sm:text-sm font-semibold text-white bg-[#0a2540] hover:bg-[#0052cc] active:scale-[0.97] rounded-full flex items-center justify-between transition-all duration-200 shadow-md shadow-[#0a2540]/15"
                  >
                    <span>Cotar no WhatsApp</span>
                    <div class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center transition-transform duration-200 group-hover/btn:translate-x-0.5">
                      <MessageCircle class="w-4 h-4 text-white" />
                    </div>
                  </a>

                  <button
                    type="button"
                    data-open-modal={category.id}
                    class="open-modal-trigger w-full min-h-[40px] py-2 px-3 text-xs font-semibold text-[#425466] hover:text-[#0a2540] hover:bg-[#0a2540]/[0.04] rounded-full transition-colors flex items-center justify-center gap-1.5 cursor-pointer active:scale-[0.97]"
                  >
                    <span>Consultar modelo específico</span>
                    <ArrowUpRight class="w-3.5 h-3.5" />
                  </button>
                </div>

              </div>
            </div>
          </div>
        );
      })}
    </div>

    {/* Bottom Banner for custom quotes with Swiss Double-Bezel */}
    <div class="mt-16 rounded-[2rem] p-1.5 bg-[#0a2540]/[0.05] border border-[#0a2540]/[0.08] shadow-lg shadow-[#0a2540]/[0.04]">
      <div class="rounded-[calc(2rem-0.375rem)] bg-[#0a2540] p-7 sm:p-9 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="text-center sm:text-left space-y-1">
          <h4 class="text-lg font-bold text-white font-display">
            Precisa de proposta para faturamento corporativo ou lote especial?
          </h4>
          <p class="text-xs sm:text-sm text-slate-300">
            Faturamento direto via boleto bancário (CNPJ) para hospitais, clínicas, escritórios e indústrias de Passos e região.
          </p>
        </div>

        <a
          href={customQuoteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-7 py-3.5 min-h-[48px] text-xs sm:text-sm font-bold text-[#0a2540] bg-white hover:bg-slate-100 rounded-full flex items-center justify-center whitespace-nowrap active:scale-[0.97] transition-all duration-200 shadow-md shrink-0"
        >
          Falar com Gerente de Contas
        </a>
      </div>
    </div>

  </div>

  {/* Native HTML5 Dialog for Specific Model Inquiry with Swiss Double-Bezel Enclosure */}
  <dialog id="model-modal" class="fixed inset-0 m-auto p-0 bg-transparent backdrop:bg-[#0a2540]/60 backdrop:backdrop-blur-md max-w-lg w-[calc(100%-2rem)] rounded-[2rem] shadow-2xl border-0">
    <div class="relative w-full rounded-[2rem] p-1.5 bg-white/40 border border-[#0a2540]/[0.08] shadow-2xl">
      <div class="rounded-[calc(2rem-0.375rem)] bg-white p-6 sm:p-8 shadow-2xl space-y-6">
        
        {/* Close Button */}
        <button
          id="close-modal-btn"
          type="button"
          class="absolute top-5 right-5 p-2 rounded-full text-[#425466] hover:text-[#0a2540] hover:bg-slate-100 transition-colors cursor-pointer active:scale-[0.95]"
          aria-label="Fechar"
        >
          <X class="w-5 h-5" />
        </button>

        {/* Modal Header */}
        <div class="space-y-1.5 pr-8">
          <div class="text-[11px] font-mono text-[#0052cc] font-semibold tracking-wider uppercase">
            Cotação Direta WhatsApp · Balcão Passos
          </div>
          <h3 id="modal-category-title" class="text-2xl font-bold font-display text-[#0a2540]">
            Categoria
          </h3>
          <p class="text-xs sm:text-sm text-[#425466]">
            Informe o modelo da sua impressora para localizarmos a peça ou suprimento homologado em nosso estoque local.
          </p>
        </div>

        {/* Form */}
        <form id="modal-quote-form" class="space-y-4">
          <div class="space-y-1.5">
            <label for="printer-model-input" class="block text-xs font-semibold text-[#0a2540]">
              Modelo da sua impressora ou código do suprimento
            </label>
            <div class="relative">
              <Printer class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-[#425466]" />
              <input
                id="printer-model-input"
                type="text"
                placeholder="Ex: HP LaserJet 107w, Epson L3250, Brother TN-1060..."
                class="w-full pl-10 pr-4 py-3 text-sm bg-[#fbfbfa] border border-[#0a2540]/[0.1] rounded-xl text-[#0a2540] placeholder:text-slate-400 focus:outline-none focus:border-[#0052cc] focus:ring-2 focus:ring-[#0052cc]/15 transition-all"
              />
            </div>
          </div>

          {/* Quick select chips for popular models */}
          <div id="modal-chips-container" class="space-y-2">
            <span class="text-[11px] text-[#425466] font-medium">Modelos frequentes na região:</span>
            <div id="modal-chips-list" class="flex flex-wrap gap-1.5">
              {/* Injected dynamically by lightweight vanilla JS */}
            </div>
          </div>

          {/* Action Buttons with Nested Island CTA */}
          <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
            <button
              type="submit"
              class="w-full sm:flex-1 min-h-[48px] py-3 px-5 text-xs sm:text-sm font-bold text-white bg-[#0a2540] hover:bg-[#0052cc] active:scale-[0.97] rounded-full flex items-center justify-center gap-2 shadow-lg shadow-[#0a2540]/15 transition-all cursor-pointer"
            >
              <MessageCircle class="w-4 h-4 text-emerald-400" />
              <span>Verificar Disponibilidade</span>
            </button>
            <button
              id="cancel-modal-btn"
              type="button"
              class="w-full sm:w-auto min-h-[48px] py-3 px-5 text-xs font-semibold text-[#425466] hover:text-[#0a2540] bg-slate-100 hover:bg-slate-200 rounded-full transition-colors cursor-pointer active:scale-[0.97]"
            >
              Cancelar
            </button>
          </div>
        </form>

        <div class="text-[11px] text-center text-[#425466]">
          Você será direcionado diretamente ao WhatsApp com a mensagem formatada para nossa equipe técnica.
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  // Filter functionality
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.category-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      
      // Update button styles
      filterBtns.forEach((b) => {
        b.className = 'filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all text-slate-500 hover:text-blue-600 cursor-pointer';
      });
      btn.className = 'filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all bg-blue-600 text-white shadow-sm cursor-pointer';

      // Show/Hide cards
      cards.forEach((card) => {
        const type = card.dataset.categoryType;
        if (filter === 'all' || type === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Modal dialog functionality
  const dialog = document.getElementById('model-modal') as HTMLDialogElement | null;
  const modalTitle = document.getElementById('modal-category-title');
  const modalInput = document.getElementById('printer-model-input') as HTMLInputElement | null;
  const chipsList = document.getElementById('modal-chips-list');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-modal-btn');
  const quoteForm = document.getElementById('modal-quote-form');

  let activeCategoryTitle = '';

  document.querySelectorAll<HTMLButtonElement>('.open-modal-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.category-card') as HTMLElement | null;
      if (!card || !dialog) return;

      activeCategoryTitle = card.dataset.categoryTitle || 'Suprimentos';
      if (modalTitle) modalTitle.textContent = activeCategoryTitle;
      if (modalInput) modalInput.value = '';

      // Populate chips
      if (chipsList) {
        chipsList.innerHTML = '';
        try {
          const models: string[] = JSON.parse(card.dataset.popularModels || '[]');
          models.forEach((m) => {
            const chip = document.createElement('button');
            chip.type = 'button';
            chip.className = 'text-xs px-2.5 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 hover:text-blue-700 border border-blue-100 hover:border-blue-300 text-blue-700 transition-all cursor-pointer text-left';
            chip.textContent = '+ ' + m;
            chip.addEventListener('click', () => {
              if (modalInput) modalInput.value = m;
            });
            chipsList.appendChild(chip);
          });
        } catch (e) {
          // ignore
        }
      }

      dialog.showModal();
    });
  });

  closeModalBtn?.addEventListener('click', () => dialog?.close());
  cancelModalBtn?.addEventListener('click', () => dialog?.close());

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  quoteForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const model = modalInput?.value?.trim() || '';
    let msg = `Olá, vi o site e tenho interesse na categoria ${activeCategoryTitle}.`;
    if (model) {
      msg = `Olá, vi o site da Mundo das Impressoras e tenho interesse na categoria "${activeCategoryTitle}" para o equipamento/modelo: ${model}. Gostaria de verificar disponibilidade e cotação.`;
    }
    const url = `https://wa.me/5535998366300?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
    dialog?.close();
  });
</script>
