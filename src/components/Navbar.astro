---
import { ArrowUpRight } from 'lucide-react';
import { getWhatsAppLink } from '../utils/whatsapp';
import { MobileNav } from './MobileNav';

const ctaWhatsApp = getWhatsAppLink('Olá, vim pelo site da Mundo das Impressoras e gostaria de falar com um atendente.');
---

<header class="fixed top-0 inset-x-0 z-50 px-4 sm:px-6 pt-3 sm:pt-5 pointer-events-none">
  <nav class="pointer-events-auto max-w-6xl mx-auto flex items-center justify-between px-4 sm:px-6 py-2.5 rounded-full bg-white/90 backdrop-blur-xl border border-[#0a2540]/[0.08] shadow-[0_8px_30px_rgba(10,37,64,0.06)] transition-all duration-300">
    
    <a href="/" class="flex items-center group outline-none transition-transform duration-200 hover:scale-105 active:scale-95">
      <img 
        src="/logo.png" 
        alt="Mundo das Impressoras" 
        class="h-8 sm:h-9 w-auto object-contain drop-shadow-sm"
        width="160"
        height="38"
        loading="eager"
      />
    </a>

    {/* Desktop Navigation with Pill Hover Effect */}
    <div class="hidden md:flex items-center gap-1 bg-[#0a2540]/[0.03] p-1 rounded-full border border-[#0a2540]/[0.04]">
      <a href="#vitrine" class="px-3.5 py-1 text-xs font-semibold tracking-tight text-[#425466] hover:text-[#0a2540] hover:bg-white rounded-full transition-all duration-200 shadow-none hover:shadow-sm">
        Categorias & Suprimentos
      </a>
      <a href="#outsourcing" class="px-3.5 py-1 text-xs font-semibold tracking-tight text-[#425466] hover:text-[#0a2540] hover:bg-white rounded-full transition-all duration-200 shadow-none hover:shadow-sm">
        Outsourcing B2B
      </a>
      <a href="#servicos" class="px-3.5 py-1 text-xs font-semibold tracking-tight text-[#425466] hover:text-[#0a2540] hover:bg-white rounded-full transition-all duration-200 shadow-none hover:shadow-sm">
        Assistência Técnica
      </a>
      <a href="#calculadora" class="px-3.5 py-1 text-xs font-semibold tracking-tight text-[#425466] hover:text-[#0a2540] hover:bg-white rounded-full transition-all duration-200 shadow-none hover:shadow-sm">
        Simulador ROI
      </a>
    </div>

    {/* CTA & Mobile Toggle */}
    <div class="flex items-center gap-3">
      {/* Nested CTA with Trailing Circular Icon Wrapper */}
      <a
        href={ctaWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
        class="group hidden sm:inline-flex items-center gap-2.5 pl-4 pr-1.5 py-1.5 text-xs font-semibold text-white bg-[#0a2540] hover:bg-[#0052cc] rounded-full border border-[#0a2540]/10 shadow-[0_4px_14px_rgba(10,37,64,0.18)] transition-all duration-200 active:scale-[0.97]"
      >
        <span>Falar com Consultor</span>
        <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
          <ArrowUpRight class="w-3.5 h-3.5 text-white" />
        </div>
      </a>

      {/* Mobile Drawer Island */}
      <MobileNav client:media="(max-width: 768px)" />
    </div>
  </nav>
</header>

