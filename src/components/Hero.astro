---
import { ArrowRight, CheckCircle2, ShieldCheck, Zap } from 'lucide-react';
import { getOutsourcingWhatsAppLink } from '../utils/whatsapp';

const outsourcingWhatsApp = getOutsourcingWhatsAppLink();
---

<section class="mesh-container pt-36 pb-24 sm:pt-44 sm:pb-32 lg:pt-48 lg:pb-36">

  {/* Dynamic Luminous Canvas Blobs */}
  <div class="mesh-blob-1" />
  <div class="mesh-blob-2" />

  <div class="mesh-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      
      {/* Left Column: Value Proposition & Executive Conversion Hooks */}
      <div class="lg:col-span-7 space-y-8 z-10">
        
        {/* Regional trust marker (Swiss Eyebrow Tag with micro-pulse) */}
        <div class="inline-flex items-center gap-2.5 rounded-full border border-[#0a2540]/[0.08] bg-white/80 px-4 py-1.5 text-[11px] font-semibold tracking-[0.18em] uppercase text-[#0a2540] shadow-[0_2px_8px_rgba(10,37,64,0.04)] backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Atendimento B2B Homologado · Passos & Região</span>
        </div>

        {/* Main Headline */}
        <h1 class="text-4xl sm:text-6xl lg:text-[4rem] font-black tracking-[-0.04em] text-[#0a2540] font-display text-balance leading-[1.08]">
          Locação de Impressoras para Empresas:{' '}
          <span class="bg-gradient-to-r from-[#0052cc] via-[#0284c7] to-[#0a2540] bg-clip-text text-transparent">
            Reduza seus custos em até 40%.
          </span>
        </h1>

        {/* Concrete Value Description */}
        <p class="text-base sm:text-lg text-[#425466] max-w-2xl leading-relaxed font-normal">
          Elimine gastos imprevistos com manutenção, peças e toners avulsos. 
          Instalamos equipamentos corporativos de alta produtividade com suporte presencial rápido em Passos e Sudoeste Mineiro.
        </p>

        {/* Direct CTAs with Nested Button-in-Button Architecture */}
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a
            href={outsourcingWhatsApp}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative inline-flex items-center justify-between min-h-[54px] gap-4 rounded-full bg-[#0a2540] hover:bg-[#0052cc] pl-7 pr-2 py-2 text-sm font-semibold text-white transition-all duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.97] shadow-[0_8px_24px_rgba(10,37,64,0.22)] whitespace-nowrap"
          >
            <span>Solicitar Estudo de Redução de Custos</span>
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 text-white transition-all duration-200 group-hover:translate-x-0.5 group-hover:scale-105">
              <ArrowRight class="h-4 w-4" />
            </div>
          </a>

          <a
            href="#vitrine"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[54px] text-sm font-semibold text-[#0a2540] hover:text-[#0052cc] bg-white hover:bg-slate-50 border border-[#0a2540]/[0.08] shadow-[0_2px_8px_rgba(10,37,64,0.04)] rounded-full transition-all duration-200 whitespace-nowrap active:scale-[0.97]"
          >
            <span>Ver Vitrine de Equipamentos</span>
          </a>
        </div>

      </div>

      {/* Right Column: Floating Volumetric Hardware Composition */}
      <div class="lg:col-span-5 relative mt-16 lg:mt-0 flex flex-col items-center justify-center">
        {/* Main Container */}
        <div class="relative w-full max-w-lg sm:max-w-xl lg:max-w-full mx-auto lg:translate-x-4">
          {/* Central Printer Image with Volumetric Drop Shadow */}
          <div class="relative z-10 animate-float lg:scale-110 xl:scale-125 transform-gpu">
            <img 
              src="/printer-hero.png" 
              alt="Impressora de Alta Performance para Outsourcing Corporativo" 
              class="w-full h-auto object-contain drop-shadow-[0_20px_35px_rgba(10,37,64,0.18)]"
              fetchpriority="high"
              width="600"
              height="450"
            />
          </div>

          {/* Floor Shadow */}
          <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 w-[85%] lg:w-[100%] h-[20px] bg-[#0a2540]/25 rounded-[50%] blur-[16px] animate-shadow z-0 lg:scale-110 xl:scale-125 transform-gpu" />

          {/* UI Badges with Swiss White Lacquer Enclosure */}
          <div class="
            static flex flex-col gap-3.5 mt-12 w-full
            md:absolute md:inset-0 md:block md:mt-0 md:w-auto
          ">
            
            {/* Badge 1: Top Right */}
            <div class="
              md:absolute md:-right-4 lg:-right-8 xl:-right-12 md:top-8 lg:top-6 xl:top-2 md:z-20 md:animate-float md:float-delay-0
              p-1 rounded-2xl bg-white/90 backdrop-blur-xl border border-[#0a2540]/[0.08] shadow-[0_12px_28px_rgba(10,37,64,0.08)]
            ">
              <div class="flex items-center gap-3 px-4 py-2 rounded-[calc(1rem-0.25rem)] bg-white shadow-sm">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-50 text-[#0052cc]">
                  <Zap class="w-3.5 h-3.5" />
                </div>
                <span class="text-[#0a2540] font-semibold text-xs sm:text-sm whitespace-nowrap">Reposição Automática de Toner</span>
              </div>
            </div>

            {/* Badge 2: Center Left */}
            <div class="
              md:absolute md:-left-8 lg:-left-12 xl:-left-16 md:top-1/2 md:-translate-y-1/2 md:z-20 md:animate-float md:float-delay-1
              p-1 rounded-2xl bg-white/90 backdrop-blur-xl border border-[#0a2540]/[0.08] shadow-[0_12px_28px_rgba(10,37,64,0.08)]
            ">
              <div class="flex items-center gap-3 px-4 py-2 rounded-[calc(1rem-0.25rem)] bg-white shadow-sm">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
                  <CheckCircle2 class="w-3.5 h-3.5" />
                </div>
                <span class="text-[#0a2540] font-semibold text-xs sm:text-sm whitespace-nowrap">Manutenção 100% Inclusa</span>
              </div>
            </div>

            {/* Badge 3: Bottom Right */}
            <div class="
              md:absolute md:-right-8 lg:-right-12 xl:-right-16 md:bottom-12 lg:bottom-8 xl:bottom-4 md:z-20 md:animate-float md:float-delay-2
              p-1 rounded-2xl bg-white/90 backdrop-blur-xl border border-[#0a2540]/[0.08] shadow-[0_12px_28px_rgba(10,37,64,0.08)]
            ">
              <div class="flex items-center gap-3 px-4 py-2 rounded-[calc(1rem-0.25rem)] bg-white shadow-sm">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-purple-50 text-purple-600">
                  <ShieldCheck class="w-3.5 h-3.5" />
                </div>
                <span class="text-[#0a2540] font-semibold text-xs sm:text-sm whitespace-nowrap">SLA Presencial em Passos</span>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

