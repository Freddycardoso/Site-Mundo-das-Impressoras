---
import { MapPin, Phone, ShieldCheck, Clock, FileText, CheckCircle2 } from 'lucide-react';
import { REGIONAL_CITIES } from '../data/categories';
import { DISPLAY_PHONE, getWhatsAppLink } from '../utils/whatsapp';

const regionalWhatsApp = getWhatsAppLink('Olá! Gostaria de consultar se vocês atendem meu endereço na região de Passos-MG.');
---

<section id="localizacao" class="relative py-28 lg:py-36 bg-[#fbfbfa] border-b border-[#0a2540]/[0.06]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Main Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      {/* Left: Authority statement */}
      <div class="lg:col-span-6 space-y-7">
        <div class="space-y-3.5">
          <div class="inline-flex items-center gap-2 rounded-full border border-[#0a2540]/[0.08] bg-white px-3.5 py-1 text-[11px] font-semibold tracking-[0.18em] uppercase text-[#0a2540] shadow-sm">
            Presença e Atendimento Local · Passos - MG
          </div>
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-[-0.035em] text-[#0a2540] font-display text-balance">
            A segurança de contratar com uma operação sediada em Passos - MG.
          </h2>
          <p class="text-sm sm:text-base text-[#425466] leading-relaxed font-normal">
            Elimine a incerteza de comprar cartucho ou toner pela internet e aguardar semanas de frete,
            ou ficar sem suporte quando a impressora trava no fechamento contábil.
          </p>
        </div>

        {/* Differential Points in Sleek Swiss Cards */}
        <div class="space-y-3 text-xs sm:text-sm text-[#425466]">
          <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white border border-[#0a2540]/[0.08] shadow-sm">
            <div class="w-8 h-8 rounded-xl bg-[#0a2540]/[0.04] flex items-center justify-center text-[#0052cc] shrink-0 mt-0.5">
              <Clock class="w-4 h-4" />
            </div>
            <div>
              <strong class="text-[#0a2540] block font-semibold text-sm mb-0.5">Entrega Expressa no Mesmo Dia em Passos</strong>
              <span class="text-[#425466]">Se o suprimento acabou, levamos com rapidez até o seu endereço para não interromper a equipe.</span>
            </div>
          </div>

          <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white border border-[#0a2540]/[0.08] shadow-sm">
            <div class="w-8 h-8 rounded-xl bg-[#0a2540]/[0.04] flex items-center justify-center text-[#0052cc] shrink-0 mt-0.5">
              <ShieldCheck class="w-4 h-4" />
            </div>
            <div>
              <strong class="text-[#0a2540] block font-semibold text-sm mb-0.5">Garantia Imediata de Balcão</strong>
              <span class="text-[#425466]">Sem logística reversa ou chats automáticos. Havendo qualquer inconformidade, a substituição é imediata na loja.</span>
            </div>
          </div>

          <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white border border-[#0a2540]/[0.08] shadow-sm">
            <div class="w-8 h-8 rounded-xl bg-[#0a2540]/[0.04] flex items-center justify-center text-[#0052cc] shrink-0 mt-0.5">
              <FileText class="w-4 h-4" />
            </div>
            <div>
              <strong class="text-[#0a2540] block font-semibold text-sm mb-0.5">Faturamento Fiscal para Empresas</strong>
              <span class="text-[#425466]">Emissão de Nota Fiscal Eletrônica e condições de boleto faturado para pessoas jurídicas cadastradas.</span>
            </div>
          </div>
        </div>

        {/* Direct Contact Button with Nested Island CTA */}
        <div class="pt-2">
          <a
            href={regionalWhatsApp}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 pl-7 pr-2.5 py-2.5 min-h-[50px] text-xs sm:text-sm font-semibold text-white bg-[#0a2540] hover:bg-[#0052cc] rounded-full shadow-lg shadow-[#0a2540]/20 transition-all duration-200 active:scale-[0.97]"
          >
            <span>Falar com Atendimento Regional: {DISPLAY_PHONE}</span>
            <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center transition-transform duration-200 group-hover:translate-x-0.5">
              <Phone class="w-4 h-4 text-white" />
            </div>
          </a>
        </div>
      </div>

      {/* Right: Regional Map & Cities Matrix with Swiss Double-Bezel Hardware Enclosure */}
      <div class="lg:col-span-6 rounded-[2rem] p-2 bg-[#0a2540]/[0.04] border border-[#0a2540]/[0.08] shadow-[0_20px_50px_rgba(10,37,64,0.06)]">
        <div class="rounded-[calc(2rem-0.5rem)] bg-white p-6 sm:p-8 space-y-6 shadow-sm border border-[#0a2540]/[0.04]">
          <div class="flex items-center justify-between pb-4 border-b border-[#0a2540]/[0.08]">
            <div class="flex items-center gap-2.5">
              <MapPin class="w-5 h-5 text-[#0052cc]" />
              <span class="font-bold text-[#0a2540] text-base font-display">Cidades Atendidas no Sudoeste de Minas</span>
            </div>
            <span class="text-[11px] font-mono font-semibold text-[#0052cc]">Base Física: Passos/MG</span>
          </div>

          <p class="text-xs sm:text-sm text-[#425466]">
            Atendemos indústrias, comércio, escolas, escritórios contábeis, órgãos públicos e clientes finais nas seguintes localidades:
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
            {REGIONAL_CITIES.map((city) => (
              <div
                key={city}
                class="px-3.5 py-2 rounded-full bg-[#fbfbfa] border border-[#0a2540]/[0.08] shadow-sm text-xs font-semibold text-[#0a2540] flex items-center gap-2 transition-all hover:bg-white hover:border-[#0052cc]/30 active:scale-[0.98]"
              >
                <CheckCircle2 class="w-3.5 h-3.5 text-[#0052cc] shrink-0" />
                <span class="truncate">{city}</span>
              </div>
            ))}
          </div>

          <div class="p-4 rounded-2xl bg-blue-50/70 border border-[#0052cc]/20 text-xs text-[#0a2540] leading-relaxed">
            <span class="font-bold text-[#0052cc]">Sua cidade não está na lista?</span> Para as demais cidades da microrregião, atendemos empresas sob contrato de Outsourcing Corporativo. Para clientes particulares de outros municípios, o recebimento é feito em nossa sede em Passos.
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
