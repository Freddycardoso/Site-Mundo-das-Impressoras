---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import CategoryShowcase from '../components/CategoryShowcase.astro';
import Testimonials from '../components/Testimonials.astro';
import OutsourcingB2B from '../components/OutsourcingB2B.astro';
import { CostCalculator } from '../components/CostCalculator';
import TechnicalServices from '../components/TechnicalServices.astro';
import RegionalTrust from '../components/RegionalTrust.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---

<Layout>
  {/* Top Bar Navigation with Fluid Island */}
  <Navbar />

  {/* Main Content Sections */}
  <main class="flex-1 pb-24 sm:pb-0">
    <Hero />
    <CategoryShowcase />
    <Testimonials />
    <OutsourcingB2B />
    {/* Interactive ROI Island loaded below-the-fold */}
    <CostCalculator client:idle />
    <TechnicalServices />
    <RegionalTrust />
    <FAQSection />
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
